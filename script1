import paramiko


def run_ssh_command(host, username, password, command):

    client = paramiko.SSHClient()

    client.set_missing_host_key_policy(
        paramiko.AutoAddPolicy()
    )

    client.connect(
        hostname=host,
        username=username,
        password=password,
        timeout=10
    )

    stdin, stdout, stderr = client.exec_command(command)

    output = stdout.read().decode()
    error = stderr.read().decode()

    client.close()

    if output:
        return output

    return error


def get_linux_health(host, username, password):

    commands = {

        "hostname":
            "hostname",

        "uptime":
            "uptime",

        "memory":
            "free -h",

        "disk":
            "df -h",

        "network":
            "ip addr",

        "failed_services":
            "systemctl --failed"
    }

    results = {}

    for name, command in commands.items():

        results[name] = run_ssh_command(
            host,
            username,
            password,
            command
        )

    return results
